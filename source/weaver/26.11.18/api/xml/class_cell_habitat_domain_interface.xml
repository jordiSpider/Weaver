        <detaileddescription>
<para>Structure:<itemizedlist>
<listitem><para>First index: <ref refid="class_animal_species_i_d" kindref="compound">AnimalSpeciesID</ref></para>
</listitem><listitem><para>Second index: <ref refid="class_instar" kindref="compound">Instar</ref></para>
</listitem><listitem><para>Value: bool indicating habitat-domain membership</para>
</listitem></itemizedlist>
</para>
