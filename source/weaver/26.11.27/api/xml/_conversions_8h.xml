</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>scaleForMassB</parametername>
</parameternamelist>
<parameterdescription>
<para>Exponent B in the allometric equation. </para>
</parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="return"><para>The corresponding dry mass of the organism. </para>
</simplesect>
</para>
