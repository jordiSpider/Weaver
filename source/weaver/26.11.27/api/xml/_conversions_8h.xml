        <type><ref refid="class_precise_double" kindref="compound">PreciseDouble</ref></type>
        <definition>PreciseDouble convertDryMassToLength</definition>
        <argsstring>(const PreciseDouble &amp;dryMass, const PreciseDouble &amp;coefficientForMassA, const PreciseDouble &amp;scaleForMassB)</argsstring>
        <name>convertDryMassToLength</name>
        <param>
          <type>const <ref refid="class_precise_double" kindref="compound">PreciseDouble</ref> &amp;</type>
          <declname>dryMass</declname>
        </param>
        <param>
          <type>const <ref refid="class_precise_double" kindref="compound">PreciseDouble</ref> &amp;</type>
          <declname>coefficientForMassA</declname>
        </param>
        <param>
          <type>const <ref refid="class_precise_double" kindref="compound">PreciseDouble</ref> &amp;</type>
          <declname>scaleForMassB</declname>
        </param>
        <briefdescription>
<para>Converts a given dry mass to organism length using the inverse allometric relationship. </para>
        </briefdescription>
        <detaileddescription>
<para>The conversion uses the formula: length = (dryMass / coefficientForMassA)^(1/scaleForMassB)</para>
<para><parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername>dryMass</parametername>
</parameternamelist>
<parameterdescription>
<para>The dry mass of the organism. </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>coefficientForMassA</parametername>
</parameternamelist>
<parameterdescription>
<para>Coefficient A in the allometric equation. </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>scaleForMassB</parametername>
</parameternamelist>
<parameterdescription>
<para>Exponent B in the allometric equation. </para>
</parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="return"><para>The corresponding length of the organism. </para>
</simplesect>
</para>
        </detaileddescription>
