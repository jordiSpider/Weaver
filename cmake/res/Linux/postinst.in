#!/bin/sh
# Installs weaverR and its dependencies in this installation's private R library.
set -e

R_DIR="@WEAVER_R_PAYLOAD_DIR@"
R_LIBRARY_DIR="@WEAVER_R_LIBRARY_DIR@"
case "$1" in
    configure)
        TARBALL=$(ls "$R_DIR"/weaverR_*.tar.gz | sort | tail -n 1)
        R_LIBS="$R_LIBRARY_DIR" R_LIBS_USER= R_LIBS_SITE= \
            Rscript --no-save --no-restore --no-site-file --no-init-file --no-environ \
            "$R_DIR/install_r_env.R" "$R_LIBRARY_DIR" "$TARBALL" "$R_DIR/cran_repo.txt"
        ;;
esac

exit 0
