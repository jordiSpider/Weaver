<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi"
     xmlns:util="http://schemas.microsoft.com/wix/UtilExtension">
    <Fragment>
        <!-- Directory generated by CPack for install(FILES ... DESTINATION R COMPONENT RPackages) -->
        <!-- The setup log is useful after rollback, but has no purpose after uninstall.
             Keep the component under CPack's known R directory and pass the log path
             as a formatted property. CPack does not declare CommonAppDataFolder in
             its generated Directory table, so a DirectoryRef to it fails at link time. -->
        <DirectoryRef Id="CM_DP_RPackages.R">
            <Component Id="removeRInstallerLogs" Guid="@WEAVER_REMOVE_R_LOGS_GUID@">
                <CreateFolder />
                <util:RemoveFolderEx On="uninstall" Property="WEAVER_INSTALL_LOG_DIR" />
            </Component>
        </DirectoryRef>
    </Fragment>
</Wix>
