<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi"
     xmlns:util="http://schemas.microsoft.com/wix/UtilExtension">
    <Fragment>
        <!-- Directory generated by CPack for the versioned R payload destination. -->
        <!-- CPack does not declare CommonAppDataFolder in its generated Directory table,
             so keep cleanup components under the known versioned R payload directory. -->
        <DirectoryRef Id="@WEAVER_R_PAYLOAD_DIR_ID@">
            <Component Id="removeRInstallerLogs" Guid="@WEAVER_REMOVE_R_LOGS_GUID@">
                <CreateFolder />
                <util:RemoveFolderEx On="uninstall" Property="WEAVER_INSTALL_LOG_DIR" />
            </Component>
        </DirectoryRef>
        <DirectoryRef Id="@WEAVER_VERSION_DIR_ID@">
            <Component Id="removeVersionedInstallTree" Guid="@WEAVER_REMOVE_INSTALL_DIR_GUID@">
                <RegistryValue Root="HKLM"
                    Key="Software\Weaver\@PROGRAM_VERSION_PADDED@\@WEAVER_EDITION@"
                    Name="InstallVersionDir"
                    Type="string"
                    Value="[INSTALL_ROOT]@PROGRAM_VERSION_PADDED@\@WEAVER_EDITION@"
                    KeyPath="yes" />
                <RegistryValue Root="HKLM"
                    Key="Software\Weaver\@PROGRAM_VERSION_PADDED@\@WEAVER_EDITION@"
                    Name="InstallVersionParentDir"
                    Type="string"
                    Value="[INSTALL_ROOT]@PROGRAM_VERSION_PADDED@" />
                <util:RemoveFolderEx On="uninstall" Property="WEAVER_INSTALL_VERSION_DIR" />
            </Component>
        </DirectoryRef>
    </Fragment>
</Wix>
