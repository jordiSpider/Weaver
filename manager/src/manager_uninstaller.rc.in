#include <windows.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,0,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
	BLOCK "StringFileInfo"
	BEGIN
		BLOCK "040904b0"
		BEGIN
			VALUE "FileDescription", "@WEAVER_MANAGER_NAME@ Uninstaller\0"
			VALUE "FileVersion", "@PROJECT_VERSION@\0"
			VALUE "InternalName", "WeaverManagerUninstaller\0"
			VALUE "OriginalFilename", "WeaverManagerUninstaller.exe\0"
			VALUE "ProductName", "@WEAVER_MANAGER_NAME@\0"
			VALUE "ProductVersion", "@PROJECT_VERSION@\0"
		END
	END
	BLOCK "VarFileInfo"
	BEGIN
		VALUE "Translation", 0x0409, 1200
	END
END
