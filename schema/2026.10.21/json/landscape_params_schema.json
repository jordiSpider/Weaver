{
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "description": "Configuration parameter: version."
    },
    "landscape": {
      "type": "object",
      "properties": {
        "simulationType": {
          "type": "string",
          "enum": [
            "Arthropods",
            "Dinosaurs",
            "Aquatic"
          ],
          "description": "Configuration parameter: simulation type."
        },
        "mapConfig": {
          "type": "object",
          "properties": {
            "mapType": {
              "type": "string",
              "enum": [
                "SpatialTree"
              ],
              "description": "Configuration parameter: map type."
            },
            "landscapeWideParams": {
              "type": "object",
              "properties": {
                "minCellSize": {
                  "type": "number",
                  "minimum": 0.0,
                  "exclusiveMinimum": true,
                  "description": "Configuration parameter: min cell size."
                },
                "numberOfCellsAxisX": {
                  "type": "integer",
                  "minimum": 2,
                  "description": "Configuration parameter: number of cells axis x."
                },
                "numberOfCellsAxisY": {
                  "type": "integer",
                  "minimum": 2,
                  "description": "Configuration parameter: number of cells axis y."
                }
              },
              "description": "Configuration parameter: landscape wide params."
            },
            "spatialTreeParams": {
              "type": "object",
              "properties": {},
              "description": "Configuration parameter: spatial tree params."
            },
            "moistureBasePatch": {
              "type": "object",
              "properties": {
                "temperatureDynamics": {
                  "type": "object",
                  "properties": {
                    "cycle": {
                      "type": "array",
                      "items": {
                        "type": "number"
                      },
                      "minItems": 1,
                      "description": "Configuration parameter: cycle."
                    }
                  },
                  "description": "Configuration parameter: temperature dynamics."
                },
                "relativeHumidityDynamics": {
                  "type": "object",
                  "properties": {
                    "dynamicsType": {
                      "type": "string",
                      "enum": [
                        "Cycle",
                        "Pulse"
                      ],
                      "description": "Configuration parameter: dynamics type."
                    },
                    "cycleParams": {
                      "type": "object",
                      "properties": {
                        "cycle": {
                          "type": "array",
                          "items": {
                            "type": "number",
                            "minimum": 0.0,
                            "maximum": 100.0
                          },
                          "minItems": 1,
                          "nullProperty": true,
                          "description": "Configuration parameter: cycle."
                        }
                      },
                      "description": "Configuration parameter: cycle params."
                    },
                    "pulseParams": {
                      "type": "object",
                      "properties": {
                        "daysBetweenPulsesRange": {
                          "type": "object",
                          "properties": {
                            "min": {
                              "type": "number",
                              "minimum": 0.0,
                              "exclusiveMinimum": true,
                              "nullProperty": true,
                              "description": "Configuration parameter: min."
                            },
                            "max": {
                              "type": "number",
                              "minimum": 0.0,
                              "exclusiveMinimum": true,
                              "nullProperty": true,
                              "description": "Configuration parameter: max."
                            }
                          },
                          "description": "Configuration parameter: days between pulses range."
                        },
                        "pulsePeakValueRange": {
                          "type": "object",
                          "properties": {
                            "min": {
                              "type": "number",
                              "minimum": 0.0,
                              "maximum": 100.0,
                              "nullProperty": true,
                              "description": "Configuration parameter: min."
                            },
                            "max": {
                              "type": "number",
                              "minimum": 0.0,
                              "maximum": 100.0,
                              "nullProperty": true,
                              "description": "Configuration parameter: max."
                            }
                          },
                          "description": "Configuration parameter: pulse peak value range."
                        },
                        "decay": {
                          "type": "object",
                          "properties": {
                            "decayType": {
                              "type": "string",
                              "enum": [
                                "NonDecay",
                                "Lineal"
                              ],
                              "description": "Configuration parameter: decay type."
                            },
                            "linealDecayParams": {
                              "type": "object",
                              "properties": {
                                "decayOverTime": {
                                  "type": "number",
                                  "minimum": 0.0,
                                  "nullProperty": true,
                                  "description": "Configuration parameter: decay over time."
                                }
                              },
                              "description": "Configuration parameter: lineal decay params."
                            }
                          },
                          "conditionals": [
                            {
                              "condition": {
                                "operatorType": "comparison",
                                "comparisonType": "equal",
                                "lhs": {
                                  "operatorType": "property",
                                  "propertyElement": "value",
                                  "relativePath": [
                                    "decayType"
                                  ]
                                },
                                "rhs": {
                                  "operatorType": "constant",
                                  "value": "Lineal"
                                }
                              },
                              "then": [
                                {
                                  "workingPath": [
                                    "linealDecayParams"
                                  ],
                                  "remove": {
                                    "nullProperty": [
                                      "decayOverTime"
                                    ]
                                  }
                                }
                              ]
                            }
                          ],
                          "description": "Configuration parameter: decay."
                        }
                      },
                      "description": "Configuration parameter: pulse params."
                    }
                  },
                  "conditionals": [
                    {
                      "condition": {
                        "operatorType": "comparison",
                        "comparisonType": "equal",
                        "lhs": {
                          "operatorType": "property",
                          "propertyElement": "value",
                          "relativePath": [
                            "dynamicsType"
                          ]
                        },
                        "rhs": {
                          "operatorType": "constant",
                          "value": "Cycle"
                        }
                      },
                      "then": [
                        {
                          "workingPath": [
                            "cycleParams"
                          ],
                          "remove": {
                            "nullProperty": [
                              "cycle"
                            ]
                          }
                        }
                      ]
                    },
                    {
                      "condition": {
                        "operatorType": "comparison",
                        "comparisonType": "equal",
                        "lhs": {
                          "operatorType": "property",
                          "propertyElement": "value",
                          "relativePath": [
                            "dynamicsType"
                          ]
                        },
                        "rhs": {
                          "operatorType": "constant",
                          "value": "Pulse"
                        }
                      },
                      "then": [
                        {
                          "workingPath": [
                            "pulseParams",
                            "daysBetweenPulsesRange"
                          ],
                          "remove": {
                            "nullProperty": [
                              "min",
                              "max"
                            ]
                          }
                        },
                        {
                          "workingPath": [
                            "pulseParams",
                            "pulsePeakValueRange"
                          ],
                          "remove": {
                            "nullProperty": [
                              "min",
                              "max"
                            ]
                          }
                        }
                      ]
                    }
                  ],
                  "description": "Configuration parameter: relative humidity dynamics."
                },
                "maximumResourceCapacityDensity": {
                  "type": "number",
                  "minimum": 0.0,
                  "description": "Configuration parameter: maximum resource capacity density."
                },
                "inEnemyFreeSpace": {
                  "type": "boolean",
                  "description": "Configuration parameter: in enemy free space."
                },
                "inCompetitorFreeSpace": {
                  "type": "boolean",
                  "description": "Configuration parameter: in competitor free space."
                }
              },
              "description": "Configuration parameter: moisture base patch."
            },
            "nutrients": {
              "type": "object",
              "properties": {
                "minC": {
                  "type": "number",
                  "description": "Configuration parameter: min c."
                },
                "maxC": {
                  "type": "number",
                  "description": "Configuration parameter: max c."
                },
                "minN": {
                  "type": "number",
                  "description": "Configuration parameter: min n."
                },
                "maxN": {
                  "type": "number",
                  "description": "Configuration parameter: max n."
                },
                "minP": {
                  "type": "number",
                  "description": "Configuration parameter: min p."
                },
                "maxP": {
                  "type": "number",
                  "description": "Configuration parameter: max p."
                }
              },
              "description": "Configuration parameter: nutrients."
            }
          },
          "description": "Configuration parameter: map config."
        },
        "life": {
          "type": "object",
          "properties": {
            "minExploitableResource": {
              "type": "number",
              "minimum": 0.0,
              "exclusiveMinimum": true,
              "description": "Configuration parameter: min exploitable resource."
            },
            "competitionAmongResourceSpecies": {
              "type": "boolean",
              "description": "Configuration parameter: competition among resource species."
            },
            "exitTimeThreshold": {
              "type": "integer",
              "minimum": 0,
              "description": "Configuration parameter: exit time threshold."
            },
            "pdfThreshold": {
              "type": "number",
              "minimum": 0.0,
              "maximum": 1.0,
              "description": "Configuration parameter: pdf threshold."
            },
            "multiplierForFieldMetabolicRate": {
              "type": "number",
              "description": "Configuration parameter: multiplier for field metabolic rate."
            }
          },
          "description": "Configuration parameter: life."
        }
      },
      "description": "Configuration parameter: landscape."
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/jordiSpider/Weaver/main/schema/2026.10.21/json/landscape_params_schema.json"
}

