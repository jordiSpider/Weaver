{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 25,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "common",
            "hidden": true,
            "description": "Base preset defining common cache variables shared by all builds.",
            "binaryDir": "$env{HOST_BUILD_DIR}/${presetName}",
            "environment": {
                "HOST_BUILD_DIR": "${sourceDir}/build/${hostSystemName}"
            },
            "cacheVariables": {
                "CMAKE_CXX_STANDARD": "20",
                "CMAKE_CXX_STANDARD_REQUIRED": "ON",
                "CMAKE_CXX_EXTENSIONS": "OFF",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "CMAKE_RUNTIME_OUTPUT_DIRECTORY": "${sourceDir}/bin/${hostSystemName}/$<CONFIG>",
                "CMAKE_LIBRARY_OUTPUT_DIRECTORY": "${sourceDir}/lib/${hostSystemName}/$<CONFIG>",
                "CMAKE_ARCHIVE_OUTPUT_DIRECTORY": "${sourceDir}/lib/${hostSystemName}/$<CONFIG>",
                "INCLUDE_DIR_NAME": "include",
                "REPO_URL": "https://github.com/jordiSpider/Weaver",
                "AUTHOR": "Jordi Moya Laraño"
            }
        },
        {
            "name": "executables",
            "hidden": true,
            "inherits": [ "common" ],
            "description": "Defines settings for building project executables.",
            "cacheVariables": {
                "PROJECT_BUILD_TYPE": "Executables",
                "SCHEMA_VERSION": "2026.08.05",
                "SERIALIZATION_VERSION": "2026.08.05",
                "SRC_DIR_NAME": "src",
                "EXECUTABLE_DIR_NAME": "bin",
                "SCHEMA_DIR_NAME": "schema",
                "CONFIG_DIR_NAME": "config",
                "X_VCPKG_APPLOCAL_DEPS_INSTALL": "ON",
                "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/external/vcpkg/scripts/buildsystems/vcpkg.cmake",
                "VCPKG_INSTALL_OPTIONS": "--clean-after-build",
                "VCPKG_INSTALLED_DIR": "$env{HOST_BUILD_DIR}/vcpkg_installed"
            },
            "environment": {
                "VCPKG_DEFAULT_BINARY_CACHE": "$env{HOST_BUILD_DIR}/vcpkg_cache"
            }
        },
        {
            "name": "windows",
            "hidden": true,
            "inherits": [ "executables" ],
            "description": "Windows-specific preset using Visual Studio 2022 and static vcpkg triplets.",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            },
            "generator": "Visual Studio 17 2022",
            "cacheVariables": {
                "VCPKG_TARGET_TRIPLET": "x64-windows-static",
                "VCPKG_HOST_TRIPLET": "x64-windows-static",
                "CPACK_NSIS_MUI_ICON": "${sourceDir}/icons/icon.ico",
                "CPACK_NSIS_MUI_UNIICON": "${sourceDir}/icons/uninstall_icon.ico"
            }
        },
        {
            "name": "linux",
            "hidden": true,
            "inherits": [ "executables" ],
            "description": "Linux-specific preset using Makefiles and static vcpkg triplets.",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            },
            "generator": "Unix Makefiles",
            "cacheVariables": {
                "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/external/vcpkg/scripts/buildsystems/vcpkg.cmake",
                "VCPKG_INSTALLED_DIR": "${sourceDir}/vcpkg_installed",
                "VCPKG_TARGET_TRIPLET": "x64-linux",
                "VCPKG_HOST_TRIPLET": "x64-linux",
                "CMAKE_MAKE_PROGRAM": "make",
                "CMAKE_CXX_COMPILER": "g++"
            }
        },
        {
            "name": "gui",
            "hidden": true,
            "inherits": [ "executables" ],
            "description": "Enables GUI mode in the project.",
            "cacheVariables": {
                "GUI": "ON"
            }
        },
        {
            "name": "non-gui",
            "hidden": true,
            "inherits": [ "executables" ],
            "description": "Disables GUI mode in the project.",
            "cacheVariables": {
                "GUI": "OFF"
            }
        },
        {
            "name": "debug",
            "hidden": true,
            "inherits": [ "executables" ],
            "description": "Preset for Debug builds (includes debug symbols).",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "release",
            "hidden": true,
            "inherits": [ "executables" ],
            "description": "Preset for Release builds (optimized for performance).",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CPACK_PACKAGE_CONTACT": "jordi@eeza.csic.es",
                "CPACK_PACKAGE_DIRECTORY": "${sourceDir}/installer/${presetName}"
            }
        },
        {
            "name": "trace",
            "hidden": true,
            "inherits": [ "release" ],
            "description": "No description",
            "cacheVariables": {
                "ENABLE_TRACE": "ON"
            }
        },
        {
            "name": "windows-gui-debug",
            "inherits": [ "windows", "gui", "debug" ],
            "description": "Windows GUI Debug configuration."
        },
        {
            "name": "windows-gui-release",
            "inherits": [ "windows", "gui", "release" ],
            "description": "Windows GUI Release configuration."
        },
        {
            "name": "windows-gui-trace",
            "inherits": [ "windows", "gui", "trace" ],
            "description": "Windows GUI Trace configuration."
        },
        {
            "name": "windows-non-gui-debug",
            "inherits": [ "windows", "non-gui", "debug" ],
            "description": "Windows Non-GUI Debug configuration."
        },
        {
            "name": "windows-non-gui-release",
            "inherits": [ "windows", "non-gui", "release" ],
            "description": "Windows Non-GUI Release configuration."
        },
        {
            "name": "windows-non-gui-trace",
            "inherits": [ "windows", "non-gui", "trace" ],
            "description": "Windows Non-GUI Trace configuration."
        },
        {
            "name": "linux-gui-debug",
            "inherits": [ "linux", "gui", "debug" ],
            "description": "Linux GUI Debug configuration."
        },
        {
            "name": "linux-gui-release",
            "inherits": [ "linux", "gui", "release" ],
            "description": "Linux GUI Release configuration."
        },
        {
            "name": "linux-gui-trace",
            "inherits": [ "linux", "gui", "trace" ],
            "description": "Linux GUI Trace configuration."
        },
        {
            "name": "linux-non-gui-debug",
            "inherits": [ "linux", "non-gui", "debug" ],
            "description": "Linux Non-GUI Debug configuration."
        },
        {
            "name": "linux-non-gui-release",
            "inherits": [ "linux", "non-gui", "release" ],
            "description": "Linux Non-GUI Release configuration."
        },
        {
            "name": "linux-non-gui-trace",
            "inherits": [ "linux", "non-gui", "trace" ],
            "description": "Linux Non-GUI Trace configuration."
        },
        {
            "name": "docs",
            "hidden": true,
            "inherits": [ "common" ],
            "description": "Base preset for building project documentation with Sphinx and Doxygen.",
            "cacheVariables": {
                "PROJECT_BUILD_TYPE": "Docs",
                "SPHINX_VERSION": "8.1.3",
                "DOXYGEN_VERSION": "1.9.8",
                "DOCS_DIR_NAME": "docs",
                "SPHINX_BUILD_DIR_NAME": "build",
                "SPHINX_SOURCE_DIR_NAME": "source",
                "API_DIR_NAME": "api",
                "DEFAULT_LANGUAGE": "en"
            }
        },
        {
            "name": "deploy-docs",
            "inherits": [ "docs" ],
            "description": "Builds and deploys the final documentation to GitHub Pages.",
            "cacheVariables": {
                "DOCS_BUILD_TYPE": "Deploy-docs"
            }
        },
        {
            "name": "build-docs-dev",
            "inherits": [ "docs" ],
            "description": "Builds documentation for development purposes (without deployment).",
            "cacheVariables": {
                "DOCS_BUILD_TYPE": "Build-docs-dev"
            }
        },
        {
            "name": "update-docs",
            "inherits": [ "docs" ],
            "description": "Updates the existing documentation deployment with new content.",
            "cacheVariables": {
                "DOCS_BUILD_TYPE": "Update-docs"
            }
        },
        {
            "name": "build-docs-locale",
            "inherits": [ "docs" ],
            "description": "Builds documentation for translation (locale generation).",
            "cacheVariables": {
                "DOCS_BUILD_TYPE": "Build-docs-locale",
                "LANGUAGES_TO_TRANSLATE": "en"
            }
        }
    ],
