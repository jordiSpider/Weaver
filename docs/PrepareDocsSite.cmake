foreach(var_name DOCS_SITE_BASELINE DOCS_GHPAGES_REMOTE DOCS_GHPAGES_BRANCH DOCS_SOURCE_DIR GIT_EXECUTABLE DOCS_GHPAGES_CHECKOUT_DIR DOCS_SITE_OUTPUT_DIR)
	if(NOT DEFINED ${var_name} OR "${${var_name}}" STREQUAL "")
		message(FATAL_ERROR "Missing local site preparation setting: ${var_name}")
	endif()
endforeach()

file(REMOVE_RECURSE "${DOCS_GHPAGES_CHECKOUT_DIR}")
get_filename_component(DOCS_GHPAGES_CHECKOUT_PARENT_DIR "${DOCS_GHPAGES_CHECKOUT_DIR}" DIRECTORY)
file(MAKE_DIRECTORY "${DOCS_GHPAGES_CHECKOUT_PARENT_DIR}")

if(DOCS_SITE_BASELINE STREQUAL "empty")
	file(REMOVE_RECURSE "${DOCS_SITE_OUTPUT_DIR}")
	file(MAKE_DIRECTORY "${DOCS_SITE_OUTPUT_DIR}")
	return()
endif()

execute_process(
	COMMAND "${GIT_EXECUTABLE}" -C "${DOCS_SOURCE_DIR}" remote get-url "${DOCS_GHPAGES_REMOTE}"
	RESULT_VARIABLE REMOTE_RESULT
	OUTPUT_VARIABLE DOCS_GHPAGES_REMOTE_URL
	ERROR_VARIABLE REMOTE_ERROR
	OUTPUT_STRIP_TRAILING_WHITESPACE
)

if(NOT REMOTE_RESULT EQUAL 0 OR "${DOCS_GHPAGES_REMOTE_URL}" STREQUAL "")
	message(FATAL_ERROR "Could not resolve Git remote '${DOCS_GHPAGES_REMOTE}': ${REMOTE_ERROR}")
endif()

execute_process(
	COMMAND "${GIT_EXECUTABLE}" clone --depth 1 --single-branch --branch "${DOCS_GHPAGES_BRANCH}" "${DOCS_GHPAGES_REMOTE_URL}" "${DOCS_GHPAGES_CHECKOUT_DIR}"
	RESULT_VARIABLE CLONE_RESULT
	OUTPUT_VARIABLE CLONE_OUTPUT
	ERROR_VARIABLE CLONE_ERROR
)

if(NOT CLONE_RESULT EQUAL 0)
	file(REMOVE_RECURSE "${DOCS_GHPAGES_CHECKOUT_DIR}")
	message(FATAL_ERROR "Could not clone '${DOCS_GHPAGES_REMOTE}' branch '${DOCS_GHPAGES_BRANCH}': ${CLONE_ERROR}${CLONE_OUTPUT}")
endif()

file(REMOVE_RECURSE "${DOCS_SITE_OUTPUT_DIR}")
file(MAKE_DIRECTORY "${DOCS_SITE_OUTPUT_DIR}")

execute_process(
	COMMAND "${CMAKE_COMMAND}" -E copy_directory "${DOCS_GHPAGES_CHECKOUT_DIR}" "${DOCS_SITE_OUTPUT_DIR}"
	RESULT_VARIABLE COPY_RESULT
	ERROR_VARIABLE COPY_ERROR
)

file(REMOVE_RECURSE
	"${DOCS_SITE_OUTPUT_DIR}/.git"
	"${DOCS_SITE_OUTPUT_DIR}/.doctrees"
	"${DOCS_GHPAGES_CHECKOUT_DIR}"
)

if(NOT COPY_RESULT EQUAL 0)
	message(FATAL_ERROR "Could not copy the existing GitHub Pages site into the local staging directory: ${COPY_ERROR}")
endif()
